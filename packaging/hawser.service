# Runs this machine's part of the network: the coordinator on the machine
# that was set up with `hawser init`, an agent on one set up with `hawser join`.
#
# Stopping the service leaves the interface up, so restarting it does not cut
# connections that are working. `hawser down` removes the interface.

[Unit]
Description=Hawser private network
After=network-online.target
Wants=network-online.target
# Docker, where it is installed, starts only once this machine has its address
# in the network. A swarm that advertises that address needs it to exist.
Before=docker.service
# Nothing to run until the machine has been set up.
ConditionPathExists=/etc/hawser/hawser.conf

[Service]
# Counts as started when hawser says the interface is up, not when it is launched.
Type=notify
# The name alone, so the same unit serves a package (/usr/bin) and
# scripts/install.sh (/usr/local/bin). systemd looks in both.
ExecStart=hawser up
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
